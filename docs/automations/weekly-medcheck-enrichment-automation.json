{
  "name": "Weekly MedCheck Enrichment Automation",
  "cadence": "weekly_monday",
  "command": "npm run enrich:weekly",
  "optional_live_pending_review_command": "npm run enrich:weekly -- --live-pending-review --max-live-promotions=75",
  "allowlisted_sources": [
    "PubMed",
    "Europe PMC",
    "OpenAlex",
    "Unpaywall",
    "CPIC Data",
    "ClinPGx"
  ],
  "forbidden_sources": [
    "Sci-Hub",
    "LibGen",
    "pirate mirrors",
    "non-allowlisted full text"
  ],
  "promotion_policy": "no_professional_review_promotion; optional live pending-review preview only when explicitly requested",
  "mode_reporting": {
    "cpic": [
      "localCandidateRecords",
      "fetchedRecords",
      "sourceRelease",
      "providerFailures"
    ],
    "clinpgx": [
      "directFetchedRecords",
      "openTargetsDerivedRecords",
      "providerFailures",
      "rateLimitEvents"
    ],
    "review": [
      "rawStagedRecords",
      "groupedReviewCandidates",
      "curatedDrafts",
      "localOverlayReviews"
    ],
    "livePendingReview": [
      "enabled",
      "maxLivePromotions",
      "totalRecords",
      "studies",
      "knownDdi",
      "labelContext"
    ]
  },
  "expected_reports": [
    "docs/audits/weekly-enrichment-report.md",
    "docs/audits/weekly-enrichment-report.json"
  ],
  "human_review_required": true
}
