{
  "schema": "diognosis.provider-allowlist.v1",
  "allowed": [
    {
      "name": "PubMed",
      "hostPatterns": ["pubmed.ncbi.nlm.nih.gov", "eutils.ncbi.nlm.nih.gov"],
      "allowedUse": "metadata and source identifiers"
    },
    {
      "name": "Europe PMC",
      "hostPatterns": ["europepmc.org", "www.ebi.ac.uk"],
      "allowedUse": "metadata and legal open-access status"
    },
    {
      "name": "OpenAlex",
      "hostPatterns": ["openalex.org", "api.openalex.org"],
      "allowedUse": "metadata and legal open-access status"
    },
    {
      "name": "Unpaywall",
      "hostPatterns": ["unpaywall.org", "api.unpaywall.org"],
      "allowedUse": "legal open-access metadata"
    },
    {
      "name": "CPIC Data",
      "hostPatterns": ["cpicpgx.org", "api.cpicpgx.org"],
      "allowedUse": "cached structured guideline/source metadata"
    },
    {
      "name": "ClinPGx",
      "hostPatterns": ["clinicaltables.nlm.nih.gov", "clinpgx.org", "api.clinpgx.org"],
      "allowedUse": "cached structured annotation/source metadata"
    },
    {
      "name": "Open Targets",
      "hostPatterns": ["platform.opentargets.org", "api.platform.opentargets.org"],
      "allowedUse": "offline context snapshots only"
    },
    {
      "name": "FDA/DailyMed Labels",
      "hostPatterns": ["dailymed.nlm.nih.gov", "api.fda.gov", "labels.fda.gov"],
      "allowedUse": "public label metadata and source identifiers"
    }
  ],
  "forbidden": [
    "Sci-Hub",
    "LibGen",
    "pirate mirrors",
    "Z-Library",
    "unknown full-text PDF mirrors",
    "non-allowlisted full text"
  ],
  "blockedHostPatterns": [
    "sci-hub",
    "scihub",
    "libgen",
    "z-lib",
    "zlibrary"
  ]
}
