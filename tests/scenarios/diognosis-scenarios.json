{
  "schemaVersion": 2,
  "description": "Regression scenarios for Diognosis model output. Old external-import fixture checks were removed from the active V1 path so the repo stays focused on committed source data.",
  "modelScenarios": [
    {
      "id": "model-codeine-fluoxetine-cyp2d6-pm",
      "name": "Codeine + fluoxetine with CYP2D6 poor metabolizer",
      "stack": ["Codeine", "Fluoxetine"],
      "genotype": { "CYP2D6": "PM" },
      "tab": "overview",
      "expect": {
        "findingTypes": ["active_moiety", "phenoconversion"],
        "activeMoietyPatterns": ["activation_failure"],
        "phenoconversionGenes": ["CYP2D6"],
        "terms": ["Codeine", "Fluoxetine", "CYP2D6", "Morphine"],
        "minFindingCards": 1,
        "minWhyPaths": 1
      }
    },
    {
